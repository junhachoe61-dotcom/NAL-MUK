# 환경 변수 예시 파일
# 이 파일을 복사하여 .env.local 파일을 만들고 실제 값으로 채워주세요.
# ⚠️ .env.local 파일은 절대 Git에 커밋하지 마세요!

# ─────────────────────────────────────────
# 앱 기본 설정
# ─────────────────────────────────────────
NODE_ENV=development
APP_NAME=p1-serverless-web
APP_VERSION=0.1.0
LOG_LEVEL=debug

# ─────────────────────────────────────────
# AWS 설정
# ─────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=123456789012

# 로컬 개발 시 LocalStack 사용 (실제 AWS 자격증명 불필요)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ─────────────────────────────────────────
# API 설정
# ─────────────────────────────────────────
API_BASE_URL=http://localhost:3001
API_VERSION=v1
API_RATE_LIMIT=100

# ─────────────────────────────────────────
# 데이터베이스 설정
# ─────────────────────────────────────────
# DynamoDB (로컬 LocalStack)
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_PREFIX=p1-dev-

# Aurora Serverless (로컬 MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/p1_dev
DATABASE_MAX_CONNECTIONS=10

# ─────────────────────────────────────────
# 캐시 설정 (Redis)
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ─────────────────────────────────────────
# 인증 설정
# ─────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=604800

# AWS Cognito (프로덕션)
# COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────
# 외부 서비스 API 키
# ─────────────────────────────────────────
# 실제 값은 Harness Secret Manager에서 관리
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG.xxx...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# ─────────────────────────────────────────
# 모니터링 설정
# ─────────────────────────────────────────
# DATADOG_API_KEY=your-datadog-api-key
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ─────────────────────────────────────────
# 프론트엔드 설정 (Next.js)
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
