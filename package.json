{
  "name": "subtrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lambda": "serverless offline start --stage dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:lambda\"",
    "build": "next build",
    "build:functions": "tsc -p tsconfig.functions.json",
    "package": "serverless package --stage dev",
    "start": "next start",
    "lint": "next lint && eslint src/functions --ext .ts",
    "lint:fix": "next lint --fix && eslint src/functions --ext .ts --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:unit:watch": "jest --testPathPattern=tests/unit --watch",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "db:setup:local": "ts-node infrastructure/scripts/setup-local-db.ts",
    "localstack:up": "docker compose up -d localstack",
    "localstack:down": "docker compose down",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:staging": "serverless deploy --stage staging"
  },
  "dependencies": {
    "next": "15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-query": "^5.59.0",
    "zustand": "^5.0.1",
    "react-hook-form": "^7.53.1",
    "zod": "^3.23.8",
    "date-fns": "^4.1.0",
    "recharts": "^2.13.3",
    "lucide-react": "^0.460.0",
    "next-auth": "^4.24.10",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@aws-sdk/client-dynamodb": "^3.682.0",
    "@aws-sdk/lib-dynamodb": "^3.682.0",
    "ulid": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.8.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "tailwindcss": "^3.4.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.2.5",
    "@playwright/test": "^1.48.2",
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.2",
    "serverless": "^3.39.0",
    "serverless-offline": "^13.9.0",
    "serverless-plugin-typescript": "^2.1.5",
    "aws-lambda": "^1.0.7",
    "@types/aws-lambda": "^8.10.145"
  }
}
